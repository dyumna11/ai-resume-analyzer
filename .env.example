# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/resume_analyzer

# JWT Authentication
JWT_SECRET_KEY=generate-a-secure-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Configuration (Set to True in HTTPS production environments)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Gemini API Key (for interview question generation & bullet enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

